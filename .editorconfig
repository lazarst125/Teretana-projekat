root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,xml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[server/Podaci/Migracije/**.cs]
generated_code = true

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0005.severity = warning

dotnet_naming_rule.konstante.symbols = konstante
dotnet_naming_rule.konstante.style = pascal
dotnet_naming_rule.konstante.severity = warning
dotnet_naming_symbols.konstante.applicable_kinds = field
dotnet_naming_symbols.konstante.required_modifiers = const

dotnet_naming_rule.staticka_readonly_polja.symbols = staticka_readonly_polja
dotnet_naming_rule.staticka_readonly_polja.style = pascal
dotnet_naming_rule.staticka_readonly_polja.severity = warning
dotnet_naming_symbols.staticka_readonly_polja.applicable_kinds = field
dotnet_naming_symbols.staticka_readonly_polja.required_modifiers = static, readonly

dotnet_naming_rule.privatna_polja.symbols = privatna_polja
dotnet_naming_rule.privatna_polja.style = donja_crta_camel
dotnet_naming_rule.privatna_polja.severity = warning
dotnet_naming_symbols.privatna_polja.applicable_kinds = field
dotnet_naming_symbols.privatna_polja.applicable_accessibilities = private

dotnet_naming_rule.interfejsi.symbols = interfejsi
dotnet_naming_rule.interfejsi.style = prefiks_i
dotnet_naming_rule.interfejsi.severity = warning
dotnet_naming_symbols.interfejsi.applicable_kinds = interface

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.donja_crta_camel.capitalization = camel_case
dotnet_naming_style.donja_crta_camel.required_prefix = _
dotnet_naming_style.prefiks_i.capitalization = pascal_case
dotnet_naming_style.prefiks_i.required_prefix = I
